<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.toka</groupId>
  <artifactId>tokaDiscordLink</artifactId>
  <version>0.3.16</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories><repository><id>plan-releases</id><url>https://repo.playeranalytics.net/releases</url></repository></repositories>
  <dependencies>
    <dependency><groupId>com.djrapitops</groupId><artifactId>plan-api</artifactId><version>5.7-R0.2</version><scope>provided</scope></dependency>
    <dependency>
      <groupId>cn.nukkit</groupId>
      <artifactId>Nukkit</artifactId>
      <version>1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.dv8tion</groupId>
      <artifactId>JDA</artifactId>
      <version>5.6.1</version>
      <exclusions>
        <!-- voice is not used, and the native opus libraries are large -->
        <exclusion>
          <groupId>club.minnced</groupId>
          <artifactId>opus-java</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>dev.toka</groupId>
      <artifactId>tokaStorage</artifactId>
      <version>0.1.4</version>
    </dependency>
    <dependency>
      <groupId>dev.toka</groupId>
      <artifactId>tokaI18n</artifactId>
      <version>0.2.2</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.6.1</version><executions><execution><id>isolated-sqlite</id><phase>prepare-package</phase><goals><goal>copy</goal></goals><configuration><artifactItems><artifactItem><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.53.4.0</version><outputDirectory>${project.build.outputDirectory}/META-INF/toka</outputDirectory><destFileName>sqlite-jdbc.jar</destFileName></artifactItem></artifactItems></configuration></execution></executions></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom><artifactSet><excludes><exclude>org.xerial:sqlite-jdbc</exclude></excludes></artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/versions/**</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <!-- The server brings its own jackson, so the copies of JDA are moved out of its way -->
              <relocations>
                <!-- The server has an old SLF4J without a logging backend; our own copy carries the bridge to the server log -->
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>dev.toka.discord.internal.slf4j</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.fasterxml.jackson</pattern>
                  <shadedPattern>dev.toka.discord.internal.jackson</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>okhttp3</pattern>
                  <shadedPattern>dev.toka.discord.internal.okhttp3</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>okio</pattern>
                  <shadedPattern>dev.toka.discord.internal.okio</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>kotlin</pattern>
                  <shadedPattern>dev.toka.discord.internal.kotlin</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.neovisionaries</pattern>
                  <shadedPattern>dev.toka.discord.internal.neovisionaries</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.commons.collections4</pattern>
                  <shadedPattern>dev.toka.discord.internal.collections4</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>dev.toka.storage</pattern>
                  <shadedPattern>dev.toka.discord.internal.storage</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>dev.toka.i18n</pattern>
                  <shadedPattern>dev.toka.discord.internal.i18n</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.yaml.snakeyaml</pattern>
                  <shadedPattern>dev.toka.discord.internal.yaml</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>gnu.trove</pattern>
                  <shadedPattern>dev.toka.discord.internal.trove</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>